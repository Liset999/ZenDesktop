{
  "zen-status": {
    "SessionStart": [
      {
        "type": "command",
        "command": "__ZEN_EXE__ hook antigravity --event SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "__ZEN_EXE__ hook antigravity --event PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__ZEN_EXE__ hook antigravity --event PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__ZEN_EXE__ hook antigravity --event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "__ZEN_EXE__ hook antigravity --event Stop",
        "timeout": 5
      }
    ]
  }
}

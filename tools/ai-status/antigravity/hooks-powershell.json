{
  "zen-status": {
    "SessionStart": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"__TOOLS_DIR__\\agent-hook.ps1\" -Agent antigravity -Event SessionStart",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"__TOOLS_DIR__\\agent-hook.ps1\" -Agent antigravity -Event PreInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"__TOOLS_DIR__\\agent-hook.ps1\" -Agent antigravity -Event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"__TOOLS_DIR__\\agent-hook.ps1\" -Agent antigravity -Event PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"__TOOLS_DIR__\\agent-hook.ps1\" -Agent antigravity -Event Stop",
        "timeout": 10
      }
    ]
  }
}
